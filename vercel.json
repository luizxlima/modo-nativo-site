{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|llms\\.txt|llms-full\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(assets|blog/img|media)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(style\\.css|app\\.js|blog/blog\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/e-book",
      "destination": "/ebook.html"
    },
    {
      "source": "/e-book/obrigado",
      "destination": "/obrigado.html"
    },
    {
      "source": "/ebook",
      "destination": "/ebook.html"
    },
    {
      "source": "/ebook/obrigado",
      "destination": "/obrigado.html"
    },
    {
      "source": "/obrigado",
      "destination": "/obrigado.html"
    },
    {
      "source": "/curso",
      "destination": "/curso.html"
    },
    {
      "source": "/curso/obrigado",
      "destination": "/curso-obrigado.html"
    },
    {
      "source": "/prova",
      "destination": "/prova.html"
    },
    {
      "source": "/analise",
      "destination": "/analise.html"
    },
    {
      "source": "/prueba",
      "destination": "/prueba.html"
    },
    {
      "source": "/avaliacao",
      "destination": "/avaliacao.html"
    },
    {
      "source": "/diagnostico",
      "destination": "/diagnostico.html"
    }
  ]
}
